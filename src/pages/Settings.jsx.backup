                                <span style={{ color: 'var(--text-secondary)' }}>Versi</span>
                                <span style={{ fontWeight: 500 }}>1.0.0</span>
                            </div>
                            <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                                <span style={{ color: 'var(--text-secondary)' }}>Build</span>
                                <span style={{ fontWeight: 500 }}>2024.01</span>
                            </div>
                            <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                                <span style={{ color: 'var(--text-secondary)' }}>Framework</span>
                                <span style={{ fontWeight: 500 }}>React + Vite</span>
