                            <div>
                                <label style={{ fontSize: '0.875rem', color: 'var(--text-secondary)', display: 'block', marginBottom: 'var(--space-1)' }}>
                                    Email
                                </label>
                                <p style={{ margin: 0, fontWeight: 500 }}>{user?.email}</p>
                            </div>
